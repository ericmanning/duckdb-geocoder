# name: test/sql/tiger1992_zip.test
# description: us_geocoder_unzip extracts entries from a zip using bundled miniz
# group: [sql]

require us_geocoder

# Extract every entry of the committed fixture zip into a temp dir.
query II
SELECT entry, bytes
FROM us_geocoder_unzip('test/data/tiger1992/zips/34998.zip', '__TEST_DIR__/unzip92')
ORDER BY entry;
----
TGR34998.F51	460
TGR34998.F5I	108

# The extracted file is readable and has the expected record count.
query I
SELECT count(*) FROM read_csv('__TEST_DIR__/unzip92/TGR34998.F51',
    columns={'line':'VARCHAR'}, delim='\x1f', header=false, quote='', escape='');
----
2

# NULL arguments are rejected at bind time with a BinderException. Without
# the check, StringValue::Get raised `INTERNAL Error: Calling
# StringValue::Get on a NULL value` plus a 25-frame stack trace and an
# invitation to file a DuckDB bug. Both positions, since either can be NULL.
statement error
SELECT * FROM us_geocoder_unzip(NULL, '__TEST_DIR__/unzip92');
----
zip_path and dest_dir are both required

statement error
SELECT * FROM us_geocoder_unzip('test/data/tiger1992/zips/34998.zip', NULL);
----
zip_path and dest_dir are both required

# dest_dir is created recursively, not single-level: api.md promises
# "creating dest_dir if needed", and a two-level missing path (the shape a
# pre-extracted `<mirror>/<ss>/<ssccc>` local mirror needs) used to fail
# with "IO Error: Failed to create directory".
query II
SELECT entry, bytes
FROM us_geocoder_unzip('test/data/tiger1992/zips/34998.zip', '__TEST_DIR__/deep92/34/34998')
ORDER BY entry;
----
TGR34998.F51	460
TGR34998.F5I	108

# A missing zip errors clearly rather than crashing.
statement error
SELECT * FROM us_geocoder_unzip('test/data/tiger1992/zips/nope.zip', '__TEST_DIR__/unzip92');
----
us_geocoder_unzip

# Re-extracting into the same directory (loader restart/retry path) must
# overwrite cleanly rather than throwing on an already-existing file.
query II
SELECT entry, bytes
FROM us_geocoder_unzip('test/data/tiger1992/zips/34998.zip', '__TEST_DIR__/unzip92')
ORDER BY entry;
----
TGR34998.F51	460
TGR34998.F5I	108

# Resource-leak-on-write-failure regression: an entry's output path that
# collides with an existing directory must make fs.OpenFile throw (not
# crash, not hang) partway through the loop, after
# mz_zip_reader_extract_to_heap has already handed back a heap buffer for
# that entry. sqllogictest has no leak detector, but a missed
# mz_free/mz_zip_reader_end on this path would show up as a crash or a
# double-free, which the test harness itself would surface.
#
# Step A: make __TEST_DIR__/TGR34998.F51 itself a *directory*, by
# extracting the fixture zip with that path as the destination.
# __TEST_DIR__ already exists (the harness creates it), so this is a
# single-level mkdir -- no bootstrapping needed. Its contents (the same
# two entries, one level deeper) are irrelevant scaffolding.
statement ok
SELECT * FROM us_geocoder_unzip('test/data/tiger1992/zips/34998.zip', '__TEST_DIR__/TGR34998.F51');

# Step B: re-extracting straight into __TEST_DIR__ now tries to open
# __TEST_DIR__/TGR34998.F51 -- a directory, from step A -- for writing,
# and must throw cleanly rather than leak or crash.
statement error
SELECT * FROM us_geocoder_unzip('test/data/tiger1992/zips/34998.zip', '__TEST_DIR__');
----
Cannot open file
