# name: test/sql/pg_intersection_regress.test
# description: Port of PG's `test-geocode_intersection_spacing` regress
#   (sql_bits/test-geocode_intersection_spacing.sql.in) — synthetic Coppell, TX
#   data covering the I-635 intersection-spacing fix (#1461). PG inserts the
#   rows in a BEGIN/ROLLBACK block; we insert them into a fresh in-memory
#   tiger schema and assert against PG's expected outputs
#   (sql_bits/test-geocode_intersection_spacing.out.in).

require us_geocoder

statement ok
LOAD spatial;

statement ok
LOAD splink_udfs;

# --- Synthetic Coppell, TX fixture (PG #1461 regress data) -------------------
# state_lookup is preseeded by LoadInternal; statefp=48 = Texas.

statement ok
INSERT INTO tiger.zip_lookup_base (zip, state, county, city, statefp) VALUES
    ('75019', 'Texas', 'Dallas', 'Coppell', '48');

statement ok
INSERT INTO tiger.place (statefp, placefp, plcidfp, name) VALUES
    ('48', '00001', '4800001', 'Coppell');

statement ok
INSERT INTO tiger.faces (statefp, tfid, placefp) VALUES
    ('48', 2001, '00001');

statement ok
INSERT INTO tiger.edges (statefp, countyfp, tlid, tfidl, tfidr, fullname,
                         tnidf, tnidt, the_geom, mtfcc) VALUES
