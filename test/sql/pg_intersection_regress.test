statement ok
INSERT INTO tiger.addr (statefp, tlid, fromhn, tohn, side, zip) VALUES
    ('48', 1001, '100', '198', 'L', '75019'),
    ('48', 1002, '0',   '0',   'L', '75019'),
    ('48', 1003, '50',  '98',  'L', '75019'),
