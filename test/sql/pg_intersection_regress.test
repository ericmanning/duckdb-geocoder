# name: test/sql/pg_intersection_regress.test
# description: Port of PG's `test-geocode_intersection_spacing` regress
# group: [sql]

#   (sql_bits/test-geocode_intersection_spacing.sql.in) — synthetic Coppell, TX
#   data covering the I-635 intersection-spacing fix (#1461). PG inserts the
#   rows in a BEGIN/ROLLBACK block; we insert them into a fresh in-memory
#   tiger schema and assert against PG's expected outputs
#   (sql_bits/test-geocode_intersection_spacing.out.in).

require us_geocoder

require-env TIGER_TEST_EXTENSIONS

statement ok
LOAD spatial;


# --- Synthetic Coppell, TX fixture (PG #1461 regress data) -------------------
# state_lookup is preseeded by LoadInternal; statefp=48 = Texas.

statement ok
INSERT INTO tiger.zip_lookup_base (zip, state, county, city, statefp) VALUES
    ('75019', 'Texas', 'Dallas', 'Coppell', '48');

statement ok
INSERT INTO tiger.place (statefp, placefp, plcidfp, name) VALUES
    ('48', '00001', '4800001', 'Coppell');

statement ok
INSERT INTO tiger.faces (statefp, tfid, placefp) VALUES
    ('48', 2001, '00001');

statement ok
INSERT INTO tiger.edges (statefp, countyfp, tlid, tfidl, tfidr, fullname,
                         tnidf, tnidt, the_geom, mtfcc) VALUES
    ('48', '113', 1001, 2001, 2001, 'N Belt Line Rd', 10, 11,
     ST_GeomFromText('MULTILINESTRING((-96.990000 32.986000,-96.990000 32.987000))'),
     'S1400'),
    ('48', '113', 1002, 2001, 2001, 'I- 635', 10, 12,
     ST_GeomFromText('MULTILINESTRING((-96.991000 32.986000,-96.989000 32.986000))'),
     'S1400'),
    ('48', '113', 1003, 2001, 2001, 'Weld Ave', 20, 21,
     ST_GeomFromText('MULTILINESTRING((-96.980000 32.980000,-96.980000 32.982000))'),
     'S1400'),
    ('48', '113', 1004, 2001, 2001, 'School Terrace', 20, 22,
     ST_GeomFromText('MULTILINESTRING((-96.981000 32.980000,-96.980000 32.980000))'),
     'S1400'),
    ('48', '113', 1005, 2001, 2001, 'Schools', 21, 23,
     ST_GeomFromText('MULTILINESTRING((-96.981000 32.982000,-96.980000 32.982000))'),
     'S1400');

statement ok
INSERT INTO tiger.featnames (statefp, tlid, fullname, name, predirabrv, suftypabrv,
                             pretypabrv, mtfcc, name_lower, fullname_norm, name_soundex) VALUES
    ('48', 1001, 'N Belt Line Rd', 'Belt Line', 'N',  'Rd',  NULL, 'S1400',
     'belt line', 'n belt line rd',  soundex('Belt Line')),
    ('48', 1002, 'I- 635',         '635',       NULL, NULL,  'I-', 'S1400',
     '635',       'i- 635',          soundex('635')),
    ('48', 1003, 'Weld Ave',       'Weld',      NULL, 'Ave', NULL, 'S1400',
     'weld',      'weld ave',        soundex('Weld')),
    ('48', 1004, 'School Terrace', 'School',    NULL, 'Ter', NULL, 'S1400',
     'school',    'school terrace',  soundex('School')),
    ('48', 1005, 'Schools',        'Schools',   NULL, NULL,  NULL, 'S1400',
     'schools',   'schools',         soundex('Schools'));

statement ok
UPDATE tiger.featnames
SET numeric_stem     = CASE WHEN name IS NOT NULL
                              AND length(name) < 10
                              AND regexp_matches(name, '^[0-9/\s]+')
                            THEN trim(regexp_extract(name, '^[0-9/\s]+')) END,
    name_first_5     = substr(name_lower, 1, 5),
    fullname_first_5 = substr(fullname_norm, 1, 5);


statement ok
INSERT INTO tiger.addr (statefp, tlid, fromhn, tohn, side, zip) VALUES
    ('48', 1001, '100', '198', 'L', '75019'),
    ('48', 1002, '0',   '0',   'L', '75019'),
    ('48', 1003, '50',  '98',  'L', '75019'),
    ('48', 1004, '0',   '0',   'L', '75019'),
    ('48', 1005, '0',   '0',   'L', '75019');

# --- #1461a: 'N Belt Line' × 'I- 635' (PG-style spaced highway) --------------
# PG expected: 100 N Belt Line Rd, Coppell, TX 75019  rating=5
# Resolved street + house number match PG. Rating differs (we return 8) because
# our scoring sums fullname+name levenshtein rather than PG's max-of-fullname-
# OR-name. Documented in docs/pg_parity.md.

query II
SELECT (adr).address, (adr).street_name
FROM tiger.geocode_intersection('N Belt Line', 'I- 635', 'TX', 'Coppell', NULL, 1)
ORDER BY rating
LIMIT 1;
----
100	Belt Line

# --- #1461a-period: 'N. Belt Line' (with period) — now matches directly ----
# geocode_intersection now internally synthesizes a fake address and runs
# each road through tiger.from_pagc (mirroring PG's L42-43 pattern with
# normalize_address). The parser strips periods and expands directionals,
# so the dotted form resolves to the same edges as the no-period form.
#
# us-better-than-PG note: PG's matcher gates the LIKE branch on
# length(streetName)>5, which fails when PAGC tokenizes 'Belt Line' into
# name='BELT'(4)+type='LINE'(4). PG itself returns 0 rows for #1461a/b
# on this synthetic data — verified against the live PG container. Our
# matcher adds an extra branch (lower(name) = parsed_streetname+streettype)
# which catches PAGC's over-split mis-tokenization.

query II
SELECT (adr).address, (adr).street_name
FROM tiger.geocode_intersection('N. Belt Line', 'I- 635', 'TX', 'Coppell', NULL, 1)
ORDER BY rating
LIMIT 1;
----
100	Belt Line

# --- #1461b: 'I-635' (no space) — same answer as #1461a ---------------------
# This is the regression: PG's parser treated 'I-635' and 'I- 635' as
# different strings before the fix. Our normalize_street_name macro collapses
# '\s*-\s*' → '-', so both forms reach the I-635 edge and the resolved
# intersection address matches PG.

query II
SELECT (adr).address, (adr).street_name
FROM tiger.geocode_intersection('N Belt Line', 'I-635', 'TX', 'Coppell', NULL, 1)
ORDER BY rating
LIMIT 1;
----
100	Belt Line

# --- #1461d: 'Weld' × 'School' — short, exact-match street names ------------
# PG expected: 50 Weld Ave, Coppell, TX 75019  rating=4 — bytewise match.

query III
SELECT (adr).address, (adr).street_name, rating
FROM tiger.geocode_intersection('Weld', 'School', 'TX', 'Coppell', NULL, 1)
ORDER BY rating
LIMIT 1;
----
50	Weld	4

# --- #1461c: parser parity for '0 353 Rte, Coppell, TX' ---------------------
# Moved to test/sql/pg_intersection_regress_pagc.test (gated on
# `require us_address_standardizer` so CI skips the assertion when the
# standardizer C-API extension isn't pre-installed).
