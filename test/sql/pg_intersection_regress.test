statement ok
INSERT INTO tiger.featnames (statefp, tlid, fullname, name, predirabrv, suftypabrv,
                             pretypabrv, mtfcc, name_lower, fullname_norm, name_soundex) VALUES
    ('48', 1001, 'N Belt Line Rd', 'Belt Line', 'N',  'Rd',  NULL, 'S1400',
