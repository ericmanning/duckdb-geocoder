# --- #1461a: 'N Belt Line' × 'I- 635' (PG-style spaced highway) --------------
# PG expected: 100 N Belt Line Rd, Coppell, TX 75019  rating=5
# Resolved street + house number match PG. Rating differs (we return 8) because
# our scoring sums fullname+name levenshtein rather than PG's max-of-fullname-
# OR-name. Documented in docs/parity.md.

query II
SELECT (addy).address, (addy).street_name
FROM tiger.geocode_intersection('N Belt Line', 'I- 635', 'TX', 'Coppell', NULL, 1)
ORDER BY rating
LIMIT 1;
----
100	Belt Line

# --- #1461a-period: 'N. Belt Line' (with period) — pre-normalize pattern ---
# PG's geocode_intersection internally synthesizes a fake address and runs it
# through normalize_address (geocode_intersection.sql L42-43):
#     normalize_address('0 ' || roadway1 || ', ' || city || ', ' || state)
# and uses streetName + streetTypeAbbrev from the parsed result. That strips
# periods and expands directionals. We don't do this inside the macro (would
# add a hard runtime dep on us_address_standardizer for every intersection
# caller), but the test below shows the pattern works at the call site:
# from_pagc gives us the same parsed components as PG's normalize_address.
#
# Caveat discovered against current PG: PG's parser tokenizes 'Belt Line' as
# name='Belt' + type='Line' (since LINE appears in street_type_lookup), and
# its matcher then can't find featnames.name='Belt Line'. So current PG
# itself returns 0 rows for ALL forms of #1461a/b on this synthetic data —
# the historical expected file (rating=5) was captured before that parser
# change. Our raw-input matcher with the length>5 LIKE branch is actually
# more robust on this case.

statement ok
LOAD us_address_standardizer;

# Pre-normalize via from_pagc and reconstruct the matchable streetname.
# This is what PG does internally (its `var_road_fullname = streetName ||
# ' ' || streetTypeAbbrev`); doing it at the call site here avoids
# changing geocode_intersection's runtime deps.
#
# road1 'N. Belt Line' → street_name='BELT', street_type='LINE'  → 'BELT LINE'
# road2 'I- 635'       → street_name='635'  (tagged 'INTERSTATE HIGHWAY' as
#   type, which doesn't match featname 'I-' prefix; just pass the name).
query II
SELECT (addy).address, (addy).street_name
FROM tiger.geocode_intersection(
    trim(
        (tiger.from_pagc('0 N. Belt Line, Coppell, TX 75019'))['street_name']
        || ' ' ||
        COALESCE((tiger.from_pagc('0 N. Belt Line, Coppell, TX 75019'))['street_type'], '')
    ),
    (tiger.from_pagc('0 I- 635, Coppell, TX 75019'))['street_name'],
    'TX', 'Coppell', NULL, 1)
ORDER BY rating
LIMIT 1;
----
100	Belt Line

# --- #1461b: 'I-635' (no space) — same answer as #1461a ---------------------
# This is the regression: PG's parser treated 'I-635' and 'I- 635' as
# different strings before the fix. Our normalize_street_name macro collapses
# '\s*-\s*' → '-', so both forms reach the I-635 edge and the resolved
# intersection address matches PG.

query II
SELECT (addy).address, (addy).street_name
FROM tiger.geocode_intersection('N Belt Line', 'I-635', 'TX', 'Coppell', NULL, 1)
ORDER BY rating
LIMIT 1;
----
100	Belt Line

# --- #1461d: 'Weld' × 'School' — short, exact-match street names ------------
# PG expected: 50 Weld Ave, Coppell, TX 75019  rating=4 — bytewise match.

query III
SELECT (addy).address, (addy).street_name, rating
FROM tiger.geocode_intersection('Weld', 'School', 'TX', 'Coppell', NULL, 1)
ORDER BY rating
LIMIT 1;
----
50	Weld	4

# --- #1461c: parser parity for '0 353 Rte, Coppell, TX' ---------------------
# PG's normalize_address yields streetname='353', streettypeabbrev='Rte'.
# We delegate to PAGC via tiger.from_pagc(); assert the same fields land on
# the from_pagc struct.

statement ok
LOAD us_address_standardizer;

query II
SELECT (tiger.from_pagc('0 353 Rte, Coppell, TX'))['street_name'],
       (tiger.from_pagc('0 353 Rte, Coppell, TX'))['street_type'];
----
353	Rte
