# Cross-reference helper: every test below uses tiger.geocode_address_impl
# directly so we get raw ratings (Stage A, no Stage B fallback).

# ============================================================
# 1. Numeric-street equivalence (numeric_streets_equal)
# ============================================================
# Input "15 St" should still match "15th St" because both names are numeric
# (per numeric_streets_equal: short numeric names with same leading digits
# are considered equivalent for rating).

query I
SELECT MIN(rating) < 30 FROM tiger.geocode_address_impl(
    CAST({address: 150, street_name: '15', street_type: 'St', pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
         AS tiger.geocode_input), 5, NULL, 2.0);
----
true

# Numeric input also matches with "rd" suffix (15rd ≡ 15th per the equivalence).
query I
SELECT MIN(rating) < 30 FROM tiger.geocode_address_impl(
    CAST({address: 150, street_name: '15rd', street_type: 'St', pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
         AS tiger.geocode_input), 5, NULL, 2.0);
----
true

# ============================================================
# 2. prequalabr handling ("Old" prefix on Main St)
# ============================================================
# Search for "Main St" should still match "Old Main St" — the prequalabr
# is treated as a discount, not a rejection.

query I
SELECT MIN(rating) < 30 FROM tiger.geocode_address_impl(
    CAST({address: 150, street_name: 'Main', street_type: 'St', pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
         AS tiger.geocode_input), 5, NULL, 2.0);
----
true

# ============================================================
# 3. Short street names (≤5 chars skip the LIKE-prefix branch)
# ============================================================
# Per geocode_address_impl, the LIKE-prefix branch only fires for input
# names with length > 5. Short names like "Oak" must match via exact or
# soundex (or numeric_streets_equal). Exact "Oak" matches; an unrelated
# short name with different soundex ("Zip" → soundex Z100 ≠ Oak's O200)
# correctly produces zero matches.

query I
SELECT MIN(rating) < 30 FROM tiger.geocode_address_impl(
    CAST({address: 150, street_name: 'Oak', street_type: 'Rd', pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
         AS tiger.geocode_input), 5, NULL, 2.0);
----
true

query I
SELECT count(*) FROM tiger.geocode_address_impl(
    CAST({address: 150, street_name: 'Zip', street_type: 'Rd', pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
         AS tiger.geocode_input), 5, NULL, 2.0);
----
0

# ============================================================
# 4. Highway spacing normalization (I-635 vs I- 635)
# ============================================================
# Both "I-635" and "I- 635" should reach the same fullname after
# normalize_street_name canonicalizes whitespace around the hyphen.

query I
SELECT MIN(rating) < 30 FROM tiger.geocode_address_impl(
    CAST({address: 150, street_name: 'I-635', street_type: NULL, pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
         AS tiger.geocode_input), 5, NULL, 2.0);
----
true

query I
SELECT MIN(rating) < 30 FROM tiger.geocode_address_impl(
    CAST({address: 150, street_name: 'I- 635', street_type: NULL, pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
         AS tiger.geocode_input), 5, NULL, 2.0);
----
true

# ============================================================
# 5. ZIP window tolerance (zip_range ±2 for long names, ±1 for short)
# ============================================================
# Long-name input ("New Hampshire") should tolerate ZIP ±2 typos.
# 02901 vs the actual 02903 = within ±2.

query I
SELECT MIN(rating) < 30 FROM tiger.geocode_address_impl(
    CAST({address: 1731, street_name: 'New Hampshire', street_type: 'Ave', pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02901'}
         AS tiger.geocode_input), 5, NULL, 2.0);
----
true

# A ZIP outside the ±2 window (02903 vs 02950) should not match.
query I
SELECT count(*) FROM tiger.geocode_address_impl(
    CAST({address: 1731, street_name: 'New Hampshire', street_type: 'Ave', pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02950'}
         AS tiger.geocode_input), 5, NULL, 2.0);
----
0

# ============================================================
# 6. House-number out-of-range (penalty +5 + scaled distance per spec §11)
# ============================================================
# Address 500 is well outside the 100-198 range on Meeting St.
# Should still match (street/type are exact), but with a higher rating
# than an in-range address, AND the adr.address output should be the
# nearest range endpoint, not the input 500.

query I
SELECT (adr).address FROM tiger.geocode_address_impl(
    CAST({address: 500, street_name: 'Meeting', street_type: 'St', pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
         AS tiger.geocode_input), 5, NULL, 2.0)
ORDER BY rating LIMIT 1;
----
198

# In-range address gets a smaller rating than out-of-range.
query I
SELECT (
    SELECT MIN(rating) FROM tiger.geocode_address_impl(
        CAST({address: 150, street_name: 'Meeting', street_type: 'St', pre_dir: NULL,
              post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
             AS tiger.geocode_input), 5, NULL, 2.0)
)
< (
    SELECT MIN(rating) FROM tiger.geocode_address_impl(
        CAST({address: 500, street_name: 'Meeting', street_type: 'St', pre_dir: NULL,
              post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
             AS tiger.geocode_input), 5, NULL, 2.0)
);
----
true

# ============================================================
# 7. House-number wrong parity (penalty +2 per spec §11)
# ============================================================
# Right side has odd addresses 101-199; passing an even address (150)
# is in-range but wrong parity. Should match with a small penalty.

query I
SELECT MIN(rating) <= 5 FROM tiger.geocode_address_impl(
    CAST({address: 150, street_name: 'Meeting', street_type: 'St', pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
         AS tiger.geocode_input), 5, NULL, 2.0);
----
true

# ============================================================
# 8. Soft penalties on type / direction abbreviation
# ============================================================
# "Avenue" vs "Ave" → +5 type penalty. Still matches, just rated worse.
# Input "1731 New Hampshire Avenue" against "New Hampshire Ave".

query I
SELECT (
    SELECT MIN(rating) FROM tiger.geocode_address_impl(
        CAST({address: 1731, street_name: 'New Hampshire', street_type: 'Avenue', pre_dir: NULL,
              post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
             AS tiger.geocode_input), 5, NULL, 2.0)
) > (
    SELECT MIN(rating) FROM tiger.geocode_address_impl(
        CAST({address: 1731, street_name: 'New Hampshire', street_type: 'Ave', pre_dir: NULL,
              post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
             AS tiger.geocode_input), 5, NULL, 2.0)
);
----
true

# ============================================================
# 9. Stage B fallback: no street_name → location-only → rating ≥ 100
# ============================================================
# Provide a ZCTA fixture so geocode_location can resolve the centroid.

statement ok
INSERT INTO tiger.zcta5 (statefp, zcta5ce, the_geom) VALUES
    ('44', '02903',
     ST_GeomFromText('POLYGON((-71.42 41.81, -71.40 41.81, -71.40 41.83, -71.42 41.83, -71.42 41.81))'));

statement ok
INSERT INTO tiger.zip_lookup_base (zip, state, county, city, statefp) VALUES
    ('02903', 'RI', 'Providence', 'Providence', '44');

# Stage B (geocode wrapper falls back when Stage A is empty).
query I
SELECT MIN(rating) >= 100 FROM tiger.geocode(
    CAST({address: NULL, street_name: NULL, street_type: NULL, pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
         AS tiger.geocode_input), 5, NULL, 'none');
----
true

# Sanity: Stage A still beats Stage B in the combined wrapper.
query I
SELECT MIN(rating) < 100 FROM tiger.geocode(
    CAST({address: 150, street_name: 'Meeting', street_type: 'St', pre_dir: NULL,
          post_dir: NULL, location: 'Providence', state_abbrev: 'RI', zip: '02903'}
         AS tiger.geocode_input), 5, NULL, 'none');
----
true
