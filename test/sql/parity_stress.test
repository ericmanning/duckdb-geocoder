# name: test/sql/parity_stress.test
# description: Stress-class regression coverage. Synthetic fixtures covering
# group: [sql]

#              the rating-formula corners spec D13 calls out: numeric
#              streets, prequalabr discount, short names, highway spacing,
#              ZIP window tolerance, house-number parity / out-of-range,
#              soft-penalty fields, Stage B fallback.
#
#              NOT a PG-parity test. Asserts our own behavior is consistent
#              and exercises each branch of the geocode_address_impl macro
#              with a minimum input set. For real PG-output mirroring see
#              scripts/parity/run_geocode_regress.sh, which runs PG's
#              vendored test inputs against our geocoder + a real TIGER
#              reference DB and diffs against PG's expected outputs.

require us_geocoder

statement ok
LOAD spatial;


# --------------------------------------------------------------------
# Shared fixture: small RI fragment with seven streets, each chosen to
# exercise one stress class. Province/place/faces/zip share across rows
# so we can compare ratings across streets within one Providence block.
# --------------------------------------------------------------------

statement ok
INSERT INTO tiger.state (statefp, stusps, name, the_geom) VALUES
    ('44', 'RI', 'Rhode Island',
     ST_GeomFromText('POLYGON((-71.9 41.1, -71.0 41.1, -71.0 42.1, -71.9 42.1, -71.9 41.1))'));

statement ok
INSERT INTO tiger.county (statefp, countyfp, cntyidfp, name, the_geom) VALUES
    ('44', '007', '44007', 'Providence',
     ST_GeomFromText('POLYGON((-71.5 41.7, -71.3 41.7, -71.3 41.9, -71.5 41.9, -71.5 41.7))'));

statement ok
INSERT INTO tiger.place (statefp, placefp, plcidfp, name, the_geom) VALUES
    ('44', '59000', '4459000', 'Providence',
     ST_GeomFromText('POLYGON((-71.45 41.80, -71.38 41.80, -71.38 41.85, -71.45 41.85, -71.45 41.80))'));

# Single shared face polygon big enough to contain every test edge below.
statement ok
INSERT INTO tiger.faces (statefp, countyfp, tfid, placefp, cousubfp, tractce20, blockce20, blkgrpce20, the_geom) VALUES
    ('44', '007', 9000, '59000', NULL, '000400', '1001', '1',
     ST_GeomFromText('POLYGON((-71.420 41.835, -71.380 41.835, -71.380 41.815, -71.420 41.815, -71.420 41.835))')),
    ('44', '007', 9001, '59000', NULL, '000400', '1002', '1',
     ST_GeomFromText('POLYGON((-71.420 41.815, -71.380 41.815, -71.380 41.795, -71.420 41.795, -71.420 41.815))'));

# Streets — one tlid per street, one edge each, one addr range each.
# tlid 1001 = "Meeting St"          (baseline, also referenced as numeric-street control)
# tlid 1002 = "Old Main St"          (prequalabr = OLD)
# tlid 1003 = "New Hampshire Ave"    (long name; soundex/Levenshtein branches)
# tlid 1004 = "15th St"              (numeric street: matches "15 St", "15rd St")
# tlid 1005 = "I-635"                (highway: normalize_street_name spacing fix)
# tlid 1006 = "Oak Rd"               (short name <= 5 chars)
# tlid 1007 = "Liberty Pkwy"         (used with NW direction for soft-penalty cases)

statement ok
INSERT INTO tiger.featnames
    (statefp, tlid, name, fullname, predirabrv, pretypabrv, prequalabr, suftypabrv, sufdirabrv, mtfcc, name_lower, fullname_norm, name_soundex) VALUES
    ('44', 1001, 'Meeting',       'Meeting St',          NULL, NULL, NULL,  'St',  NULL, 'S1400', 'meeting',       'meeting st',          soundex('Meeting')),
    ('44', 1002, 'Main',          'Old Main St',         NULL, NULL, 'OLD', 'St',  NULL, 'S1400', 'main',          'old main st',         soundex('Main')),
    ('44', 1003, 'New Hampshire', 'New Hampshire Ave',   NULL, NULL, NULL,  'Ave', NULL, 'S1400', 'new hampshire', 'new hampshire ave',   soundex('New Hampshire')),
    ('44', 1004, '15th',          '15th St',             NULL, NULL, NULL,  'St',  NULL, 'S1400', '15th',          '15th st',             soundex('15th')),
    ('44', 1005, 'I-635',         'I-635',               NULL, NULL, NULL,  NULL,  NULL, 'S1100', 'i-635',         tiger.normalize_street_name('I-635'), soundex('I-635')),
    ('44', 1006, 'Oak',           'Oak Rd',              NULL, NULL, NULL,  'Rd',  NULL, 'S1400', 'oak',           'oak rd',              soundex('Oak')),
    ('44', 1007, 'Liberty',       'Liberty Pkwy NW',     NULL, NULL, NULL,  'Pkwy','NW',  'S1400', 'liberty',       'liberty pkwy nw',     soundex('Liberty'));

statement ok
UPDATE tiger.featnames
SET numeric_stem     = CASE WHEN name IS NOT NULL
                              AND length(name) < 10
                              AND regexp_matches(name, '^[0-9/\s]+')
                            THEN trim(regexp_extract(name, '^[0-9/\s]+')) END,
    name_first_5     = substr(name_lower, 1, 5),
    fullname_first_5 = substr(fullname_norm, 1, 5);


statement ok
