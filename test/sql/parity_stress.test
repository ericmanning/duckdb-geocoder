    ('44', '007', 1003, 9000, 9001, 3005, 3006, 'S1400', 'New Hampshire Ave',
     ST_GeomFromText('LINESTRING(-71.405 41.824, -71.403 41.824)'), '02903', '02903'),
    ('44', '007', 1004, 9000, 9001, 3007, 3008, 'S1400', '15th St',
     ST_GeomFromText('LINESTRING(-71.405 41.823, -71.403 41.823)'), '02903', '02903'),
    ('44', '007', 1005, 9000, 9001, 3009, 3010, 'S1100', 'I-635',
     ST_GeomFromText('LINESTRING(-71.405 41.822, -71.403 41.822)'), '02903', '02903'),
    ('44', '007', 1006, 9000, 9001, 3011, 3012, 'S1400', 'Oak Rd',
