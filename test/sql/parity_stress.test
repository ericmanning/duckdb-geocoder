    ('44', 1001, '100', '198', 'L', '02903', NULL),
    ('44', 1001, '101', '199', 'R', '02903', NULL),
    ('44', 1002, '100', '198', 'L', '02903', NULL),
    ('44', 1002, '101', '199', 'R', '02903', NULL),
    ('44', 1003, '1700', '1798', 'L', '02903', NULL),
    ('44', 1003, '1701', '1799', 'R', '02903', NULL),
    ('44', 1004, '100', '198', 'L', '02903', NULL),
    ('44', 1004, '101', '199', 'R', '02903', NULL),
