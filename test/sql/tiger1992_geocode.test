# name: test/sql/tiger1992_geocode.test
# description: forward geocoding against 1992-vintage data
# group: [sql]

require us_geocoder

require-env TIGER_TEST_EXTENSIONS

statement ok
LOAD spatial;

statement ok
CALL load_tiger_1992_state('NJ', source := 'test/data/tiger1992');

# Derived zip tables built from the reused modern sections.
query III
SELECT (SELECT count(*) FROM tiger.zip_state),
       (SELECT count(*) FROM tiger.zip_state_loc),
       (SELECT count(*) FROM tiger.zip_lookup_base);
----
1	1	1

query III
SELECT zip, state, city FROM tiger.zip_lookup_base;
----
07825	NJ	Fixture

# edge_containment: GEOIDs present, guaranteed_* hard false.
query III
SELECT tlid, tract_geoid_l, guaranteed_l FROM tiger.edge_containment ORDER BY tlid;
----
9001	34999012345	false
9002	34999012345	false

# Forward geocode: house 50 on Fixture Road. Two addr ranges cover tlid 9001
# (1-99 L, 2-98 R); 50 parity-matches the R range and wins the rating (see
# the block_geoid query below for why).
query IIII
SELECT g.rating, (g.adr).street_name, (g.adr).street_type, (g.adr).zip
FROM tiger.geocode({'address':50,'street_name':'Fixture','street_type':'Rd',
                    'internal':NULL,'pre_dir':NULL,'post_dir':NULL,
                    'location':NULL,'state_abbrev':'NJ','zip':'07825'}::tiger.geocode_input,
                   1, NULL, 'none') g;
----
15	Fixture	Road	07825

# The interpolated point lies on the chain's bounding box.
query I
SELECT ST_X(g.geom) BETWEEN -74.9601 AND -74.9499
   AND ST_Y(g.geom) BETWEEN 40.9899 AND 40.9951
FROM tiger.geocode({'address':50,'street_name':'Fixture','street_type':'Rd',
                    'internal':NULL,'pre_dir':NULL,'post_dir':NULL,
                    'location':NULL,'state_abbrev':'NJ','zip':'07825'}::tiger.geocode_input,
                   1, NULL, 'none') g;
----
true

# Block GEOID is populated and 1990-vintage (15 chars here: 4-digit block).
#
# House 50 is even, so it parity-matches the R-side range (2-98, hn_max=98,
# even) rather than the L-side range (1-99, hn_max=99, odd) — see
# geocode_address.sql.in's address-rating CASE: an in-range candidate whose
# parity doesn't match hn_max's parity pays a +2 penalty vs. +0 for a parity
# match, so the R-side addr row outranks L and wins the LIMIT-1 ORDER BY
# rating. block_geoid is selected per the winning a_side (CASE a_side WHEN
# 'L' THEN block_geoid_l ELSE block_geoid_r END), so the correct value here
# is block_geoid_r for tlid 9001 (349990123451002), not block_geoid_l.
# Verified directly: tiger.edges has tfidl=...0001/tfidr=...0002 for tlid
# 9001, and tiger.edge_containment computed block_geoid_l=...1001,
# block_geoid_r=...1002 for that row — both as designed.
query II
SELECT g.block_geoid, length(g.block_geoid)
FROM tiger.geocode({'address':50,'street_name':'Fixture','street_type':'Rd',
                    'internal':NULL,'pre_dir':NULL,'post_dir':NULL,
                    'location':NULL,'state_abbrev':'NJ','zip':'07825'}::tiger.geocode_input,
                   1, NULL, 'none') g;
----
349990123451002	15

# The 14-char case, and the whole point of fixture polygon 3.
#
# Real 1992 RTA records store CTBNA (cols 41-46) as a 4-digit basic tract
# plus a BLANK-filled 2-char suffix ('0301  ', not '030100'); the canonical
# 1990 tract code zero-fills that suffix. Polygon 3 is the only fixture
# polygon in that shape, and it also carries a 3-digit BLK ('201 '), so it
# is the only one that distinguishes the template's correct
# zero-fill-the-suffix from a plain trim() of the whole field. A trim()
# yields tract '0301' and the lengths 9 / 10 / 12 below instead of
# 11 / 12 / 14 -- which is what shipped, on ~60% of real 1990 tracts, with
# the 15-char assertion above green the whole time.
#
# Routed through tiger.geocode() rather than read off edge_containment so
# this pins the public API: house 151 is odd and in R range 101-199
# (hn_max 199, odd -> parity match, +0) rather than L range 100-198
# (hn_max 198, even -> +2), so the winning a_side is 'R' and block_geoid
# resolves to block_geoid_r, i.e. fixture polygon 3 via tlid 9002's
# POLYIDR.
query IIIIII
SELECT g.tract_geoid, length(g.tract_geoid),
       g.blkgrp_geoid, length(g.blkgrp_geoid),
       g.block_geoid, length(g.block_geoid)
FROM tiger.geocode({'address':151,'street_name':'Second','street_type':'Ave',
                    'internal':NULL,'pre_dir':NULL,'post_dir':NULL,
                    'location':NULL,'state_abbrev':'NJ','zip':'07825'}::tiger.geocode_input,
                   1, NULL, 'none') g;
----
34999030100	11	349990301002	12	34999030100201	14

# Every GEOID the 1992 path emits is one of the two documented widths
# (docs/tiger1992.md § Vintage caveats, pg_parity.md D15): tract 11,
# blkgrp 12, block 14 or 15. Nothing 9, 10, 12 or 13 wide on the block
# column.
query III
SELECT count(*) FILTER (WHERE length(tract_geoid_l) <> 11 OR length(tract_geoid_r) <> 11),
       count(*) FILTER (WHERE length(blkgrp_geoid_l) <> 12 OR length(blkgrp_geoid_r) <> 12),
       count(*) FILTER (WHERE length(block_geoid_l) NOT IN (14, 15)
                           OR length(block_geoid_r) NOT IN (14, 15))
FROM tiger.edge_containment;
----
0	0	0

# The alternate name from RT4/RT5 also matches.
query I
SELECT count(*) FROM tiger.geocode(
  {'address':50,'street_name':'Old Fixture','street_type':'Rd','internal':NULL,
   'pre_dir':NULL,'post_dir':NULL,'location':NULL,'state_abbrev':'NJ','zip':'07825'}::tiger.geocode_input,
  1, NULL, 'none');
----
1

# Review Focus 5: require_containment != 'none' returns zero rows, no error.
query I
SELECT count(*) FROM tiger.geocode(
  {'address':50,'street_name':'Fixture','street_type':'Rd','internal':NULL,
   'pre_dir':NULL,'post_dir':NULL,'location':NULL,'state_abbrev':'NJ','zip':'07825'}::tiger.geocode_input,
  1, NULL, 'block');
----
0

# Documented limitation: reverse geocoding returns nothing (no face polygons).
query I
SELECT count(*) FROM tiger.reverse_geocode(ST_Point(-74.955, 40.9925), 5);
----
0

# Documented limitation: geocode_location's place-centroid tier returns
# ZERO ROWS for city-only input, not a NULL-geometry row.
#
# 1992 populates place.name with place.the_geom NULL for every row, and
# place_tier had no `the_geom IS NOT NULL` filter, so city-only input
# produced one row with geom NULL and rating 100 -- a successful match by
# every caller's reading, propagating straight out of the public
# tiger.geocode(). That contradicted docs/tiger1992.md's capability matrix
# and pg_parity.md D15, and is strictly worse for consumers than no row
# (ST_Distance -> NULL, NOT NULL inserts fail, "zero rows means no match"
# stops holding). Asserted at both layers: the macro and the public entry
# point.
query I
SELECT count(*) FROM tiger.geocode_location_impl(
  CAST({address: NULL, street_name: NULL, street_type: NULL, pre_dir: NULL,
        post_dir: NULL, location: 'Fixture', state_abbrev: 'NJ', zip: NULL}
       AS tiger.geocode_input), NULL);
----
0

query II
SELECT count(*), count(geom) FROM tiger.geocode(
  {'address':NULL,'street_name':NULL,'street_type':NULL,'internal':NULL,
   'pre_dir':NULL,'post_dir':NULL,'location':'Fixture','state_abbrev':'NJ',
   'zip':NULL}::tiger.geocode_input, 5, NULL, 'none');
----
0	0

# Unload clears every per-state table and the progress keys.
statement ok
CALL unload_tiger_1992_state('NJ');

query IIIII
SELECT (SELECT count(*) FROM tiger.edges), (SELECT count(*) FROM tiger.faces),
       (SELECT count(*) FROM tiger.featnames), (SELECT count(*) FROM tiger.addr),
       (SELECT count(*) FROM tiger.edge_containment);
----
0	0	0	0	0

query II
SELECT (SELECT count(*) FROM tiger.state), (SELECT count(*) FROM tiger.county);
----
0	0
