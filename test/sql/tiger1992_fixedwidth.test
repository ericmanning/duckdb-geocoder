# name: test/sql/tiger1992_fixedwidth.test
# description: 1992 TIGER fixed-width field extraction, CFCC map, node IDs
# group: [sql]

require us_geocoder

# NOTE ON SCOPE: the queries below re-express the loader's substr() offsets
# inline rather than running the shipped template. That is partly forced --
# the real county_edges section is one INSERT with ST_MakeLine over a
# generate_series unpivot, not a SELECT this harness can slice up -- but it
# means offset drift between this file and
# src/sql/loader_1992_templates.sql.in is invisible here. The end-to-end
# coverage that catches drift is tiger1992_load.test / tiger1992_geocode.test
# / tiger1992_incremental.test, which call the real loader against the same
# fixture; treat this file as covering the arithmetic and the CFCC map only.

# ---- RT1 field extraction -------------------------------------------------
query IIIIII
WITH src AS (
  SELECT rtrim(line, chr(13)) AS line
  FROM read_csv('test/data/tiger1992/34/34999/TGR34999.F51',
       columns={'line':'VARCHAR'}, delim='\x1f', header=false, quote='', escape='')
)
SELECT substr(line,6,10)::BIGINT AS tlid,
       nullif(trim(substr(line,20,30)),'') AS fename,
       nullif(trim(substr(line,50,4)),'')  AS fetype,
       trim(substr(line,56,3))             AS cfcc,
       nullif(trim(substr(line,59,11)),'') AS fraddl,
       nullif(trim(substr(line,107,5)),'') AS zipl
FROM src WHERE length(line) >= 228 ORDER BY tlid;
----
9001	Fixture	Road	A41	1	07825
9002	Second	Ave	A41	100	07825

# ---- Review Focus 2: leading zeros in ZIP survive as text ----------------
query I
WITH src AS (
  SELECT rtrim(line, chr(13)) AS line
  FROM read_csv('test/data/tiger1992/34/34999/TGR34999.F51',
       columns={'line':'VARCHAR'}, delim='\x1f', header=false, quote='', escape='')
)
SELECT DISTINCT nullif(trim(substr(line,107,5)),'') FROM src WHERE length(line) >= 228;
----
07825

# ---- CFCC -> MTFCC map ---------------------------------------------------
query II
SELECT cfcc, tiger.cfcc_to_mtfcc(cfcc) AS mtfcc
FROM (VALUES ('A11'),('A21'),('A31'),('A41'),('A51'),('A63'),('A74'),('A00'),('H01'),('B11')) v(cfcc)
ORDER BY cfcc;
----
A00	S1400
A11	S1100
A21	S1200
A31	S1400
A41	S1400
A51	S1500
A63	S1500
A74	S1500
B11	XB11
H01	XH01

# ---- Node ID arithmetic: deterministic, collision-free, fits BIGINT -----
# Shared endpoint of chains 9001/9002 (-74.950000, +40.995000) must yield
# the SAME id from 9001's to-node and 9002's from-node.
query I
WITH src AS (
  SELECT rtrim(line, chr(13)) AS line
  FROM read_csv('test/data/tiger1992/34/34999/TGR34999.F51',
       columns={'line':'VARCHAR'}, delim='\x1f', header=false, quote='', escape='')
), nodes AS (
  SELECT (trim(substr(line,210,10))::BIGINT + 180000000) * 1000000000
         + (trim(substr(line,220,9))::BIGINT + 90000000) AS nid
  FROM src WHERE substr(line,6,10)::BIGINT = 9001
  UNION ALL
  SELECT (trim(substr(line,191,10))::BIGINT + 180000000) * 1000000000
         + (trim(substr(line,201,9))::BIGINT + 90000000)
  FROM src WHERE substr(line,6,10)::BIGINT = 9002
)
SELECT count(DISTINCT nid) FROM nodes;
----
1

# Signed fields with leading '+' and leading spaces both cast.
query III
SELECT '+40996043'::BIGINT, ' -74960022'::BIGINT,
       (105050000::BIGINT + 180000000) * 1000000000 + (40990000 + 90000000);
----
40996043	-74960022	285050000130990000

# ---- Review Focus 3: short / blank lines are skipped ---------------------
#
# Deleted, not rewritten here: this was `SELECT count(*) FROM (VALUES
# ('short'),(''),(NULL)) WHERE length(line) >= 228`, which asserted
# DuckDB's length() against its own literals and never touched the loader's
# filter. Real coverage now lives in tiger1992_load.test's sparse92
# section, where the committed fixture TGR34997.F51 carries a truncated
# 28-char record plus an empty line and the load must still produce exactly
# 2 edges -- a load that stopped filtering would raise a cast error on the
# truncated record instead.

# ---- L/R address unpivot -------------------------------------------------
query IIII
WITH src AS (
  SELECT rtrim(line, chr(13)) AS line
  FROM read_csv('test/data/tiger1992/34/34999/TGR34999.F51',
       columns={'line':'VARCHAR'}, delim='\x1f', header=false, quote='', escape='')
), rt1 AS (
  SELECT substr(line,6,10)::BIGINT AS tlid,
         nullif(trim(substr(line,59,11)),'') AS fraddl,
         nullif(trim(substr(line,70,11)),'') AS toaddl,
         nullif(trim(substr(line,81,11)),'') AS fraddr,
         nullif(trim(substr(line,92,11)),'') AS toaddr
  FROM src WHERE length(line) >= 228
)
SELECT tlid, fromhn, tohn, side FROM (
  SELECT tlid, fraddl AS fromhn, toaddl AS tohn, 'L' AS side FROM rt1
  UNION ALL SELECT tlid, fraddr, toaddr, 'R' FROM rt1
) WHERE fromhn IS NOT NULL ORDER BY tlid, side;
----
9001	1	99	L
9001	2	98	R
9002	100	198	L
9002	101	199	R

# ---- Review Focus 1: a zero-byte / absent optional file yields zero rows -
#
# Deleted, not rewritten here: this COPY'd an empty file and counted
# read_csv's rows over it, which tested DuckDB's CSV reader rather than
# PathOrEmpty or any loader code. The behaviour it meant to cover -- a
# county with no RT2/RT4/RT5/RT6 files loading cleanly -- is exercised
# end-to-end by tiger1992_load.test's sparse92 section (county 34997 ships
# F51/F5A/F5I only, and the assertion is that addr/featnames come back 4/2
# rather than erroring).
