-- Stage A — vectorized address-match macro.
-- See geocode_flow.md §7 for the PostGIS cascade we're collapsing and §14.1
-- for the D7 "single vectorized pass, LIMIT at end" spec.
--
-- Depends on spatial (ST_Intersects, interpolate_from_address) and
-- splink_udfs (soundex). Registered best-effort by LoadInternal.
--
-- Inputs:
--   inp               : tiger.geocode_input struct
--   max_results       : INT
--   restrict_geom_4269: GEOMETRY in EPSG:4269, or NULL
--   zip_penalty       : DOUBLE, PG default 2
--
-- Returns candidate rows:
--   (addy, geom, rating, block_geoid, tract_geoid, blkgrp_geoid, containment_guaranteed)
-- Stage A produces rating in the [0, 99] band for address matches.
-- Ordered by rating ascending, truncated to max_results.
--
-- Implementation notes:
--   * DuckDB can't correlate a struct macro parameter reliably into nested
--     subqueries, so we unpack `inp` into a CTE `p` using bracket notation
--     (inp['field']) and reference p.field throughout.
--   * Candidate filtering is pushed down in two stages:
--     (i) `name_match_tlids` pre-filters featnames to just matching tlids
--         (by exact name, soundex, prefix, numeric-street, or normalized
--         fullname). Cuts ~126K featnames to ~tens in the common case.
--     (ii) `candidates` does the full join only over those tlids, with the
--          faces-side join split into L/R UNION ALL branches (DuckDB can't
--          hash-join on (A AND L) OR (B AND R) efficiently — it degenerates
--          to a cartesian product).
--   * block/tract/blkgrp GEOIDs come from edge_containment (Phase 6); when
--     that table is empty all three GEOID columns are NULL and
--     containment_guaranteed is false.

CREATE OR REPLACE MACRO @TIGER@.geocode_address_impl(inp, max_results, restrict_geom_4269, zip_penalty) AS TABLE (
    WITH
    -- Unpack the struct parameter and compute per-call derived values
    -- (statefp, zip window) as columns on the same 1-row relation so they
    -- work under CROSS JOIN LATERAL in batch mode. Using separate CTEs with
    -- `(SELECT ... FROM cte)` scalar subqueries makes DuckDB decorrelate,
    -- which breaks when the outer batch has >1 row.
    p AS (
        SELECT
            inp['address']      AS address,
            inp['street_name']  AS street_name,
            inp['street_type']  AS street_type,
            inp['internal']     AS internal,
            inp['pre_dir']      AS pre_dir,
            inp['post_dir']     AS post_dir,
            inp['location']     AS location,
            inp['state_abbrev'] AS state_abbrev,
            inp['zip']          AS zip,
            COALESCE(
                (SELECT sl.statefp FROM @TIGER@.state_lookup sl
                 WHERE inp['state_abbrev'] IS NOT NULL AND sl.abbrev = inp['state_abbrev']
                 LIMIT 1),
                (SELECT zlb.statefp FROM @TIGER@.zip_lookup_base zlb
                 WHERE inp['zip'] IS NOT NULL AND zlb.zip = inp['zip']
                 LIMIT 1)
            ) AS statefp,
            CASE WHEN inp['zip'] IS NULL THEN NULL::VARCHAR[]
                 ELSE @TIGER@.zip_range(inp['zip'], -2, 2)
            END AS window_zips,
            -- Precomputed match keys so the UNION ALL branches below
            -- hash-join directly instead of the planner failing to hoist
            -- soundex()/lower()/normalize_street_name() into the join key.
            lower(inp['street_name'])       AS street_name_lower,
            soundex(inp['street_name'])     AS street_name_soundex,
            @TIGER@.normalize_street_name(
                COALESCE(inp['street_name'], '') || ' ' || COALESCE(inp['street_type'], '')
            )                               AS fullname_norm_input,
            -- Prefix pattern used by the fullname-LIKE branch below; mirrors
            -- PG's primary stage_a "lower(fullname) LIKE (predir||' '||name||'%')"
            -- so candidates whose TIGER fullname carries an extra prequalabr
            -- or sufdir slot (e.g. "Old Cedar Ave S" when input is "OLD CEDAR")
            -- are still found.
            @TIGER@.normalize_street_name(
                COALESCE(inp['pre_dir'] || ' ', '') || COALESCE(inp['street_name'], '')
            )                               AS fullname_prefix_input
    ),
    -- Pre-filter featnames to matching tlids. Each branch is an equi-join
    -- (or a prefix range) that DuckDB can hash/sort-merge cheaply, instead
    -- of an OR-predicate that degenerates to a cartesian product. UNION ALL
    -- is fine — downstream `ranked` dedups by (name, type, side, ...).
    name_match_tlids AS (
        -- Exact name (case-insensitive) — equijoin on precomputed keys.
        SELECT f.tlid, f.statefp,
               f.name, f.fullname, f.predirabrv, f.suftypabrv, f.pretypabrv,
               f.sufdirabrv, f.prequalabr,
               p.window_zips, p.street_name AS p_street_name,
               p.street_type AS p_street_type, p.zip AS p_zip,
               p.pre_dir AS p_pre_dir, p.post_dir AS p_post_dir,
               p.location AS p_location, p.address AS p_address, p.internal AS p_internal
        FROM @TIGER@.featnames f JOIN p
             ON f.statefp = p.statefp
            AND f.name_lower = p.street_name_lower
        WHERE p.street_name IS NOT NULL

        UNION ALL
        -- Normalized fullname match — equijoin on precomputed keys.
        SELECT f.tlid, f.statefp, f.name, f.fullname, f.predirabrv, f.suftypabrv,
               f.pretypabrv, f.sufdirabrv, f.prequalabr,
               p.window_zips, p.street_name, p.street_type, p.zip,
               p.pre_dir, p.post_dir, p.location, p.address, p.internal
        FROM @TIGER@.featnames f JOIN p
             ON f.statefp = p.statefp
            AND f.fullname_norm = p.fullname_norm_input
        WHERE p.street_name IS NOT NULL

        UNION ALL
        -- Prefix match for long names (no equi-hash; sequential within state).
        SELECT f.tlid, f.statefp, f.name, f.fullname, f.predirabrv, f.suftypabrv,
               f.pretypabrv, f.sufdirabrv, f.prequalabr,
               p.window_zips, p.street_name, p.street_type, p.zip,
               p.pre_dir, p.post_dir, p.location, p.address, p.internal
        FROM @TIGER@.featnames f, p
        WHERE f.statefp = p.statefp
          AND p.street_name IS NOT NULL
          AND length(p.street_name) > 5
          AND f.name_lower LIKE p.street_name_lower || '%'

        UNION ALL
        -- Fullname prefix LIKE — catches TIGER fullnames that carry trailing
        -- prequalabr/sufdir tokens not present in the input (e.g. parsed
        -- "OLD CEDAR" matches TIGER fullname "Old Cedar Ave S"). Matches
        -- PG's primary stage_a clause; length>5 gate matches PG's behavior.
        SELECT f.tlid, f.statefp, f.name, f.fullname, f.predirabrv, f.suftypabrv,
               f.pretypabrv, f.sufdirabrv, f.prequalabr,
               p.window_zips, p.street_name, p.street_type, p.zip,
               p.pre_dir, p.post_dir, p.location, p.address, p.internal
        FROM @TIGER@.featnames f, p
        WHERE f.statefp = p.statefp
          AND p.street_name IS NOT NULL
          AND length(p.street_name) > 5
          AND f.fullname_norm LIKE p.fullname_prefix_input || '%'

        UNION ALL
        -- Soundex fallback — equijoin on precomputed name_soundex.
        -- Length-gated to match PG's primary stage_a behavior (only uses
        -- soundex when streetName > 5 chars). Short streetNames are common
        -- digit-stems like "35", "101", "9" — soundex of any digit string
        -- is uniformly '0000', so without the gate this branch matches every
        -- digit-named street in the state and floods the candidate set with
        -- spurious matches that outrank the real one.
        SELECT f.tlid, f.statefp, f.name, f.fullname, f.predirabrv, f.suftypabrv,
               f.pretypabrv, f.sufdirabrv, f.prequalabr,
               p.window_zips, p.street_name, p.street_type, p.zip,
               p.pre_dir, p.post_dir, p.location, p.address, p.internal
        FROM @TIGER@.featnames f JOIN p
             ON f.statefp = p.statefp
            AND f.name_soundex = p.street_name_soundex
        WHERE p.street_name IS NOT NULL
          AND length(p.street_name) > 5

        UNION ALL
        -- Numeric-street equivalence (15th ≡ 15rd) — expression-based.
        SELECT f.tlid, f.statefp, f.name, f.fullname, f.predirabrv, f.suftypabrv,
               f.pretypabrv, f.sufdirabrv, f.prequalabr,
               p.window_zips, p.street_name, p.street_type, p.zip,
               p.pre_dir, p.post_dir, p.location, p.address, p.internal
        FROM @TIGER@.featnames f, p
        WHERE f.statefp = p.statefp
          AND p.street_name IS NOT NULL
          AND @TIGER@.numeric_streets_equal(f.name, p.street_name)
    ),
    -- Materialize the base join (featnames filter + addr + edges). These are
    -- cheap once name_match_tlids has narrowed featnames. p_* columns carry
    -- per-input parameters (address, location, etc.) forward without
    -- re-joining to `p` inside an inner subquery, which would decorrelate
    -- under LATERAL batch calls.
    fae AS (
        SELECT
            f.name, f.fullname, f.predirabrv, f.suftypabrv, f.pretypabrv,
            f.sufdirabrv, f.prequalabr,
            a.fromhn, a.tohn, a.side, a.zip AS a_zip,
            e.tlid AS e_tlid, e.statefp AS e_statefp, e.countyfp AS e_countyfp,
            e.tfidl, e.tfidr, e.mtfcc AS e_mtfcc, e.the_geom AS edge_geom,
            f.p_address, f.p_location, f.p_pre_dir, f.p_post_dir, f.p_internal,
            f.p_street_name, f.p_street_type, f.p_zip, f.window_zips
        FROM name_match_tlids f
        JOIN @TIGER@.addr  a ON a.tlid = f.tlid AND a.statefp = f.statefp
        JOIN @TIGER@.edges e ON e.tlid = f.tlid AND e.statefp = f.statefp
        WHERE e.mtfcc LIKE 'S%'
          AND (restrict_geom_4269 IS NULL OR ST_Intersects(e.the_geom, restrict_geom_4269))
          AND (f.p_zip IS NULL
               OR a.zip IN (SELECT UNNEST(f.window_zips)))
    ),
    -- Split the faces join by side so DuckDB can use hash joins on each branch.
    fae_faces AS (
        SELECT fae.*, fc.tfid AS fc_tfid, fc.placefp, fc.cousubfp
        FROM fae JOIN @TIGER@.faces fc
             ON fc.statefp = fae.e_statefp AND fc.tfid = fae.tfidl
        WHERE fae.side = 'L'
        UNION ALL
        SELECT fae.*, fc.tfid AS fc_tfid, fc.placefp, fc.cousubfp
        FROM fae JOIN @TIGER@.faces fc
             ON fc.statefp = fae.e_statefp AND fc.tfid = fae.tfidr
        WHERE fae.side = 'R'
    ),
    candidates AS (
        SELECT
            ff.name             AS f_name,
            ff.fullname         AS f_fullname,
            ff.predirabrv       AS f_predir,
            ff.suftypabrv       AS f_suftype,
            ff.pretypabrv       AS f_pretype,
            ff.sufdirabrv       AS f_sufdir,
            ff.prequalabr       AS f_prequalabr,
            ff.fromhn           AS a_fromhn,
            ff.tohn             AS a_tohn,
            ff.side             AS a_side,
            ff.a_zip            AS a_zip,
            ff.edge_geom        AS edge_geom,
            ff.e_tlid           AS e_tlid,
            ff.tfidl            AS f_tfidl,
            ff.tfidr            AS f_tfidr,
            ff.e_statefp        AS fc_statefp,
            pl.name             AS place_name,
            cs.name             AS cousub_name,
            ct.name             AS county_name,
            st.stusps           AS state_abbrev,
            ff.p_address        AS p_address,
            ff.p_location       AS p_location,
            ff.p_internal       AS p_internal,
            @TIGER@.rate_attributes(
                ff.p_pre_dir, ff.predirabrv,
                ff.p_street_name, ff.name,
                -- Match PG: rate_attributes compares input street_type
                -- against the candidate's suftypabrv only — NOT a COALESCE
                -- of suftypabrv/pretypabrv. The slot encoding is meaningful
                -- (highway-style "Co Rd" lives in pretypabrv; ordinary "St"
                -- lives in suftypabrv); a slot mismatch indicates the
                -- parser put the type in a different position than TIGER
                -- stores it, which is real signal. Output addy struct
                -- still uses COALESCE(suftype, pretype) below — only
                -- scoring changes.
                ff.p_street_type, ff.suftypabrv,
                ff.p_post_dir, ff.sufdirabrv,
                ff.prequalabr
            )
            + CASE
                WHEN ff.p_address IS NULL OR ff.fromhn IS NULL THEN 20
                WHEN ff.p_address BETWEEN @TIGER@.least_hn(ff.fromhn, ff.tohn) AND @TIGER@.greatest_hn(ff.fromhn, ff.tohn)
                     AND (ff.p_address % 2) = (@TIGER@.greatest_hn(ff.fromhn, ff.tohn) % 2) THEN 0
                WHEN ff.p_address BETWEEN @TIGER@.least_hn(ff.fromhn, ff.tohn) AND @TIGER@.greatest_hn(ff.fromhn, ff.tohn) THEN 2
                -- Out-of-range: PG's scaled penalty (5..10) prefers
                -- candidates whose range is closer to the input house num.
                -- Without this our flat +5 ties all out-of-range candidates
                -- and the dedup tiebreak (e_tlid) picks the "wrong" edge.
                ELSE ((1.0 - (
                            LEAST(ff.p_address, @TIGER@.least_hn(ff.fromhn, ff.tohn))::DOUBLE
                            / GREATEST(1, GREATEST(ff.p_address, @TIGER@.greatest_hn(ff.fromhn, ff.tohn)))
                      )) * 5)::INTEGER + 5
              END
            + CASE
                WHEN ff.p_zip IS NULL THEN 1
                WHEN ff.a_zip IS NULL THEN 0
                ELSE LEAST(@TIGER@.diff_zip(ff.p_zip, ff.a_zip) * zip_penalty, 20 * zip_penalty)::INTEGER
              END
            + CASE
                WHEN ff.p_location IS NULL THEN 5
                WHEN pl.name IS NOT NULL THEN @TIGER@.levenshtein_ignore_case(ff.p_location, pl.name)
                WHEN cs.name IS NOT NULL THEN @TIGER@.levenshtein_ignore_case(ff.p_location, cs.name)
                ELSE 5
              END AS rating
        FROM fae_faces ff
        LEFT JOIN @TIGER@.place  pl ON pl.statefp = ff.e_statefp AND pl.placefp  = ff.placefp
        LEFT JOIN @TIGER@.cousub cs ON cs.statefp = ff.e_statefp AND cs.cousubfp = ff.cousubfp
        LEFT JOIN @TIGER@.county ct ON ct.statefp = ff.e_statefp AND ct.countyfp = ff.e_countyfp
        JOIN      @TIGER@.state  st ON st.statefp = ff.e_statefp
    ),
    ranked AS (
        SELECT
            STRUCT_PACK(
                -- Match PG's behavior: when the input house number falls
                -- inside the candidate edge's range with parity match
                -- ("exact_address"), echo it back as-is. Otherwise clamp
                -- to the nearest endpoint of the edge's range — gives a
                -- more useful output (an address that actually exists on
                -- the picked edge) than echoing back the user's possibly-
                -- bogus number.
                address      := CASE
                                  WHEN p_address IS NULL OR a_fromhn IS NULL THEN p_address
                                  WHEN p_address BETWEEN @TIGER@.least_hn(a_fromhn, a_tohn)
                                                     AND @TIGER@.greatest_hn(a_fromhn, a_tohn)
                                       AND (p_address % 2) = (@TIGER@.greatest_hn(a_fromhn, a_tohn) % 2)
                                  THEN p_address
                                  WHEN p_address > @TIGER@.greatest_hn(a_fromhn, a_tohn)
                                       AND p_address > @TIGER@.least_hn(a_fromhn, a_tohn)
                                  THEN @TIGER@.greatest_hn(a_fromhn, a_tohn)
                                  ELSE @TIGER@.least_hn(a_fromhn, a_tohn)
                                END,
                -- Mirror PG's `fename` concept: candidate street name is
                -- `prequalabr || ' ' || name` so prequalabr-bearing TIGER
                -- entries (e.g. name='Cedar', prequalabr='Old') render as
                -- "Old Cedar" rather than just "Cedar".
                street_name  := CASE
                                  WHEN f_prequalabr IS NOT NULL
                                  THEN f_prequalabr || ' ' || f_name
                                  ELSE f_name
                                END,
                street_type  := COALESCE(f_suftype, f_pretype),
                -- internal (unit/suite) round-trips from input — TIGER edges
                -- don't carry unit info, so we pass through whatever PAGC
                -- captured. Matches PG: addy.internal := parsed.internal.
                internal     := p_internal,
                pre_dir      := f_predir,
                post_dir     := f_sufdir,
                location     := COALESCE(place_name, cousub_name, county_name, p_location),
                state_abbrev := state_abbrev,
                zip          := a_zip
            )::@TIGER@.geocode_input AS addy,
            @TIGER@.interpolate_from_address(p_address, a_fromhn, a_tohn, edge_geom, a_side, 10) AS geom,
            rating,
            CASE a_side WHEN 'L' THEN ec.block_geoid_l  ELSE ec.block_geoid_r  END AS block_geoid,
            CASE a_side WHEN 'L' THEN ec.tract_geoid_l  ELSE ec.tract_geoid_r  END AS tract_geoid,
            CASE a_side WHEN 'L' THEN ec.blkgrp_geoid_l ELSE ec.blkgrp_geoid_r END AS blkgrp_geoid,
            COALESCE(
                CASE a_side WHEN 'L' THEN ec.guaranteed_l ELSE ec.guaranteed_r END,
                false
            ) AS containment_guaranteed,
            ROW_NUMBER() OVER (
                PARTITION BY f_name, COALESCE(f_suftype, f_pretype), f_sufdir, place_name, state_abbrev, a_zip
                ORDER BY rating, a_fromhn, f_tfidr, f_tfidl DESC
            ) AS dedup_rn,
            f_tfidr, f_tfidl
        FROM candidates c
        LEFT JOIN @TIGER@.edge_containment ec
               ON ec.statefp = c.fc_statefp AND ec.tlid = c.e_tlid
    ),
    -- Apply the dedup filter BEFORE the global rating ROW_NUMBER. Doing
    -- both ROW_NUMBERs in parallel and then AND-filtering produced an
    -- empty result whenever the globally-lowest-rated rows were duplicates
    -- (dedup_rn != 1) within their own partitions — the WHERE clause
    -- dropped everything because no row satisfied (dedup_rn=1 AND
    -- rating_rn <= max_results) simultaneously. Nesting fixes that.
    --
    -- Secondary sort uses TIGER's tfidr/tfidl (PG's exact tiebreak — see
    -- geocode_address.sql:175 `ORDER BY 10, 11 DESC` which positions
    -- correspond to tfidr, tfidl). More principled than X/Y geom coords
    -- (which would introduce a directional bias when many candidates
    -- tied on rating) and matches PG's pick on rating-tied candidates.
    deduped AS (
        SELECT addy, geom, rating, block_geoid, tract_geoid, blkgrp_geoid, containment_guaranteed,
               ROW_NUMBER() OVER (ORDER BY rating, f_tfidr, f_tfidl DESC) AS rating_rn
        FROM ranked
        WHERE dedup_rn = 1
    )
    SELECT addy, geom, rating, block_geoid, tract_geoid, blkgrp_geoid, containment_guaranteed
    FROM deduped
    WHERE rating_rn <= max_results
    ORDER BY rating, rating_rn
);
