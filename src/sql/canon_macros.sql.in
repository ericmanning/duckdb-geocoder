-- Canonicalization macros for geocode_input fields.
-- Coerce free-form user input into TIGER's abbreviation vocabulary so
-- rate_attributes scores accurately. See pg_parity.md § Locked design decisions for the contract.

CREATE OR REPLACE MACRO @TIGER@.canon_street_type(t) AS (
    COALESCE(
        (SELECT abbrev FROM @TIGER@.street_type_lookup
         WHERE upper(name) = upper(t)
         LIMIT 1),
        t
    )
);

CREATE OR REPLACE MACRO @TIGER@.canon_dir(d) AS (
    COALESCE(
        (SELECT abbrev FROM @TIGER@.direction_lookup
         WHERE upper(name) = upper(d)
         LIMIT 1),
        upper(d)
    )
);

CREATE OR REPLACE MACRO @TIGER@.canon_state(s) AS (
    (SELECT abbrev FROM @TIGER@.state_lookup
     WHERE upper(s) IN (upper(abbrev), upper(name))
     LIMIT 1)
);

CREATE OR REPLACE MACRO @TIGER@.canon_zip(z) AS (
    CASE
        WHEN z IS NULL THEN NULL
        WHEN length(z) >= 5 AND regexp_matches(left(z, 5), '^\d{5}$') THEN left(z, 5)
        WHEN regexp_matches(z, '^\d{1,4}$') THEN lpad(z, 5, '0')
        ELSE NULL
    END
);

-- Maps a 1992 TIGER CFCC code to its closest modern MTFCC equivalent.
-- Single source of truth for the county_edges / county_featnames 1992
-- loader templates (loader_1992_templates.sql.in) — both insert into
-- tables whose consumers filter on mtfcc LIKE 'S%', so the two must agree.
CREATE OR REPLACE MACRO @TIGER@.cfcc_to_mtfcc(cfcc) AS (
    CASE WHEN cfcc LIKE 'A1%' THEN 'S1100'
         WHEN cfcc LIKE 'A2%' THEN 'S1200'
         WHEN cfcc LIKE 'A3%' OR cfcc LIKE 'A4%' THEN 'S1400'
         WHEN cfcc LIKE 'A5%' OR cfcc LIKE 'A6%' OR cfcc LIKE 'A7%' THEN 'S1500'
         WHEN cfcc LIKE 'A%'  THEN 'S1400'
         ELSE 'X' || cfcc END
);
