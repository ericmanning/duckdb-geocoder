-- Per-table INSERT templates for the TIGER loader. Sections are delimited
-- by lines of the form "-- @SECTION:name@" and parsed by
-- src/loader.cpp::GetLoaderTemplate(). Placeholders substituted per-call:
--   @TIGER@      → target data location ("tiger" locally, or "refdb.tiger" in Mode 3)
--   @FUNC@       → local function/macro location (always "tiger" in current catalog)
--   @VSIPATH@    → '/vsizip/<source>/<zip>/<shp>' (HTTP or local filesystem)
--   @STATEFP@    → 2-digit state FIPS (county-level tables only)
--   @COUNTYFP@   → 3-digit county FIPS (county-level tables only)
--
-- @TIGER@ and @FUNC@ are the same string for in-DB loads; they differ only
-- when writing to an attached catalog via target_db. Macro calls must use
-- @FUNC@ because macros are installed once, locally, at extension load.

-- @SECTION:nation_state@
INSERT INTO @TIGER@.state (statefp, stusps, name, the_geom)
SELECT STATEFP, STUSPS, NAME, geom
FROM ST_Read('@VSIPATH@')
WHERE STATEFP NOT IN (SELECT statefp FROM @TIGER@.state WHERE statefp IS NOT NULL);

-- @SECTION:nation_county@
INSERT INTO @TIGER@.county (statefp, countyfp, cntyidfp, name, the_geom)
SELECT STATEFP, COUNTYFP, GEOID, NAME, geom
FROM ST_Read('@VSIPATH@')
WHERE GEOID NOT IN (SELECT cntyidfp FROM @TIGER@.county WHERE cntyidfp IS NOT NULL);

-- @SECTION:nation_zcta5@
-- 2020 ZCTA shapefile uses ZCTA5CE20 column name.
-- statefp left NULL in v0.1 (per-state clipping is a Phase 6 follow-up).
INSERT INTO @TIGER@.zcta5 (statefp, zcta5ce, the_geom)
SELECT NULL, ZCTA5CE20, geom
FROM ST_Read('@VSIPATH@')
WHERE ZCTA5CE20 NOT IN (SELECT zcta5ce FROM @TIGER@.zcta5 WHERE zcta5ce IS NOT NULL);

-- @SECTION:state_place@
INSERT INTO @TIGER@.place (statefp, placefp, plcidfp, name, the_geom)
SELECT STATEFP, PLACEFP, GEOID, NAME, geom
FROM ST_Read('@VSIPATH@');

-- @SECTION:state_cousub@
INSERT INTO @TIGER@.cousub (statefp, countyfp, cousubfp, cosbidfp, name, the_geom)
SELECT STATEFP, COUNTYFP, COUSUBFP, GEOID, NAME, geom
FROM ST_Read('@VSIPATH@');

-- County-level sections split into two parts:
--   *_insert : the INSERT prefix (target table + column list)
--   *_branch : a single SELECT over ST_Read; C++ concatenates one branch
--              per county with UNION ALL, letting DuckDB parallelize the
--              /vsicurl/ fetches instead of issuing N serial HTTP calls.

-- @SECTION:county_edges_insert@
INSERT INTO @TIGER@.edges (statefp, countyfp, tlid, tfidl, tfidr, tnidf, tnidt, mtfcc, fullname, the_geom, zipl, zipr)

-- @SECTION:county_edges_branch@
SELECT '@STATEFP@', '@COUNTYFP@', TLID, TFIDL, TFIDR, TNIDF, TNIDT, MTFCC, FULLNAME, geom,
       NULLIF(ZIPL, ''), NULLIF(ZIPR, '')
FROM ST_Read('@VSIPATH@')

-- @SECTION:county_faces_insert@
INSERT INTO @TIGER@.faces (statefp, countyfp, tfid, placefp, cousubfp, tractce20, blockce20, blkgrpce20, the_geom)

-- @SECTION:county_faces_branch@
SELECT '@STATEFP@', '@COUNTYFP@', TFID,
       NULLIF(PLACEFP, ''), NULLIF(COUSUBFP, ''),
       NULLIF(TRACTCE20, ''), NULLIF(BLOCKCE20, ''), NULLIF(BLKGRPCE20, ''),
       geom
FROM ST_Read('@VSIPATH@')

-- @SECTION:county_featnames_insert@
-- name_lower, fullname_norm, and name_soundex are precomputed equi-join
-- keys used by geocode_address_impl (name match), cutting the Stage A
-- filter from ~15s to ~50ms on a full-state batch. soundex is a built-in
-- scalar function registered by LoadInternal (see vendored_soundex.hpp).
INSERT INTO @TIGER@.featnames (statefp, countyfp, tlid, name, fullname, predirabrv, pretypabrv, prequalabr, suftypabrv, sufdirabrv, mtfcc, name_lower, fullname_norm, name_soundex)

-- @SECTION:county_featnames_branch@
SELECT '@STATEFP@', '@COUNTYFP@', TLID, NAME, FULLNAME,
       NULLIF(PREDIRABRV, ''), NULLIF(PRETYPABRV, ''), NULLIF(PREQUALABR, ''),
       NULLIF(SUFTYPABRV, ''), NULLIF(SUFDIRABRV, ''), MTFCC,
       lower(NAME),
       @FUNC@.normalize_street_name(FULLNAME),
       soundex(NAME)
FROM ST_Read('@VSIPATH@')

-- @SECTION:county_addr_insert@
INSERT INTO @TIGER@.addr (statefp, countyfp, tlid, fromhn, tohn, side, zip, plus4)

-- @SECTION:county_addr_branch@
SELECT '@STATEFP@', '@COUNTYFP@', TLID, FROMHN, TOHN, SIDE, NULLIF(ZIP, ''), NULLIF(PLUS4, '')
FROM ST_Read('@VSIPATH@')

-- @SECTION:derived_zip_state@
-- per-state zip → (stusps, statefp) from edges' zipl/zipr.
-- No NOT EXISTS guard: unload_state above DELETEs every zip_state row for
-- this statefp, so the target is empty for this state by construction.
INSERT INTO @TIGER@.zip_state (zip, stusps, statefp)
SELECT DISTINCT z.zip, st.stusps, '@STATEFP@'
FROM (
    SELECT zipl AS zip FROM @TIGER@.edges WHERE statefp = '@STATEFP@' AND zipl IS NOT NULL
    UNION
    SELECT zipr AS zip FROM @TIGER@.edges WHERE statefp = '@STATEFP@' AND zipr IS NOT NULL
) z
JOIN @TIGER@.state st ON st.statefp = '@STATEFP@';

-- @SECTION:derived_zip_state_loc@
-- No NOT EXISTS guard: unload_state DELETEs every zip_state_loc row for
-- this statefp before this INSERT runs.
--
-- The semantically-equivalent OR-on-join `fc.tfid = e.tfidl OR fc.tfid =
-- e.tfidr` makes DuckDB's planner fall back to a nested-loop join (edges×
-- faces) — pathological at state scale (e.g. AL = ~1.5M edges × ~80K faces).
-- Splitting into UNION ALL of two equality joins lets each half run as a
-- hash join. Output is bytewise identical because for each edge the OR
-- form would have visited both faces anyway.
WITH edge_face AS (
    SELECT e.zipl, e.zipr, fc.placefp
    FROM @TIGER@.edges e
    JOIN @TIGER@.faces fc ON fc.statefp = e.statefp AND fc.tfid = e.tfidl
    WHERE e.statefp = '@STATEFP@'
    UNION ALL
    SELECT e.zipl, e.zipr, fc.placefp
    FROM @TIGER@.edges e
    JOIN @TIGER@.faces fc ON fc.statefp = e.statefp AND fc.tfid = e.tfidr
    WHERE e.statefp = '@STATEFP@'
)
INSERT INTO @TIGER@.zip_state_loc (zip, stusps, statefp, place)
SELECT DISTINCT z.zip, st.stusps, '@STATEFP@', pl.name
FROM edge_face ef
JOIN @TIGER@.place pl ON pl.statefp = '@STATEFP@' AND pl.placefp = ef.placefp
JOIN @TIGER@.state st ON st.statefp = '@STATEFP@'
CROSS JOIN LATERAL (VALUES (ef.zipl), (ef.zipr)) AS z(zip)
WHERE z.zip IS NOT NULL;

-- @SECTION:derived_zcta5_clip@
-- Per-state ZCTA clipping (geocode_flow.md §14.9). For each ZCTA whose
-- nation polygon shares interior with this state's polygon, INSERT a row
-- carrying the within-state slice of the polygon and statefp populated.
-- USPS ZCTAs legitimately cross state lines (e.g. 03579 Errol NH spilling
-- into Maine), so cross-state ZCTAs naturally produce one row per
-- intersecting state, each with that state's clipped polygon.
--
-- Predicate is `ST_Intersects AND NOT ST_Touches`. TIGER's polygons are
-- topologically clean — NH's southern edge IS MA's northern edge — so
-- ST_Intersects returns true for any NH-side ZCTA touching the MA border
-- (boundary contact counts as intersection). ST_Touches is precisely
-- "share boundary but no interior," so subtracting it from ST_Intersects
-- gives "interior overlap" — exactly the cases that produce a non-degenerate
-- 2D clip. Cleaner than filtering ST_Area > 0 after the fact, and skips
-- the ST_Intersection compute for boundary-only touches entirely.
--
-- The original NULL-statefp nation row stays in place so reverse_geocode
-- still resolves ZCTAs in unloaded states via the spatial fallback.
INSERT INTO @TIGER@.zcta5 (statefp, zcta5ce, the_geom)
SELECT '@STATEFP@', zr.zcta5ce, ST_Intersection(zr.the_geom, st.the_geom)
FROM @TIGER@.zcta5 zr
CROSS JOIN @TIGER@.state st
WHERE zr.statefp IS NULL
  AND st.statefp = '@STATEFP@'
  AND ST_Intersects(zr.the_geom, st.the_geom)
  AND NOT ST_Touches(zr.the_geom, st.the_geom);

-- @SECTION:derived_edge_containment@
-- Per-edge-per-side containment precomputation (geocode_flow.md §14.3).
-- The guaranteed_* flags are the v0.1 single-midpoint approximation:
-- project to UTM, interpolate at 0.5, offset 10m perpendicular via
-- interpolate_from_address, then check ST_Within the adjacent face.
-- This matches the default offset used by geocode_address Stage A.
-- Conservative: an edge that's actually fully inside the face but whose
-- midpoint offset lands near a face boundary may read as false.
-- GEOIDs are populated regardless of the guarantee; they come directly
-- from faces (statefp || countyfp || tractce20 || blockce20 etc.).
INSERT INTO @TIGER@.edge_containment
    (statefp, tlid, guaranteed_l, guaranteed_r,
     block_geoid_l, tract_geoid_l, blkgrp_geoid_l,
     block_geoid_r, tract_geoid_r, blkgrp_geoid_r)
SELECT
    e.statefp, e.tlid,
    CASE WHEN f_l.the_geom IS NULL THEN false
         ELSE ST_Within(
                  @FUNC@.interpolate_from_address(1, '1', '1', e.the_geom, 'L', 10),
                  f_l.the_geom)
    END AS guaranteed_l,
    CASE WHEN f_r.the_geom IS NULL THEN false
         ELSE ST_Within(
                  @FUNC@.interpolate_from_address(1, '1', '1', e.the_geom, 'R', 10),
                  f_r.the_geom)
    END AS guaranteed_r,
    CASE WHEN f_l.tractce20 IS NULL OR f_l.blockce20 IS NULL THEN NULL
         ELSE e.statefp || f_l.countyfp || f_l.tractce20 || f_l.blockce20 END AS block_geoid_l,
    CASE WHEN f_l.tractce20 IS NULL THEN NULL
         ELSE e.statefp || f_l.countyfp || f_l.tractce20 END AS tract_geoid_l,
    CASE WHEN f_l.tractce20 IS NULL OR f_l.blkgrpce20 IS NULL THEN NULL
         ELSE e.statefp || f_l.countyfp || f_l.tractce20 || f_l.blkgrpce20 END AS blkgrp_geoid_l,
    CASE WHEN f_r.tractce20 IS NULL OR f_r.blockce20 IS NULL THEN NULL
         ELSE e.statefp || f_r.countyfp || f_r.tractce20 || f_r.blockce20 END AS block_geoid_r,
    CASE WHEN f_r.tractce20 IS NULL THEN NULL
         ELSE e.statefp || f_r.countyfp || f_r.tractce20 END AS tract_geoid_r,
    CASE WHEN f_r.tractce20 IS NULL OR f_r.blkgrpce20 IS NULL THEN NULL
         ELSE e.statefp || f_r.countyfp || f_r.tractce20 || f_r.blkgrpce20 END AS blkgrp_geoid_r
FROM @TIGER@.edges e
LEFT JOIN @TIGER@.faces f_l ON f_l.statefp = e.statefp AND f_l.tfid = e.tfidl
LEFT JOIN @TIGER@.faces f_r ON f_r.statefp = e.statefp AND f_r.tfid = e.tfidr
WHERE e.statefp = '@STATEFP@';

-- @SECTION:derived_zip_lookup_base@
-- No NOT EXISTS guard: unload_state DELETEs every zip_lookup_base row for
-- this statefp before this INSERT runs. UNION-ALL the two face matches
-- explicitly to avoid the OR-on-join → nested-loop fallback (see notes on
-- derived_zip_state_loc above for details).
WITH edge_face AS (
    SELECT e.zipl, e.zipr, fc.placefp, fc.countyfp
    FROM @TIGER@.edges e
    JOIN @TIGER@.faces fc ON fc.statefp = e.statefp AND fc.tfid = e.tfidl
    WHERE e.statefp = '@STATEFP@'
    UNION ALL
    SELECT e.zipl, e.zipr, fc.placefp, fc.countyfp
    FROM @TIGER@.edges e
    JOIN @TIGER@.faces fc ON fc.statefp = e.statefp AND fc.tfid = e.tfidr
    WHERE e.statefp = '@STATEFP@'
)
INSERT INTO @TIGER@.zip_lookup_base (zip, state, county, city, statefp)
SELECT DISTINCT z.zip, st.stusps, c.name, pl.name, '@STATEFP@'
FROM edge_face ef
LEFT JOIN @TIGER@.place pl ON pl.statefp = '@STATEFP@' AND pl.placefp = ef.placefp
JOIN @TIGER@.county c ON c.statefp = '@STATEFP@' AND c.countyfp = ef.countyfp
JOIN @TIGER@.state st ON st.statefp = '@STATEFP@'
CROSS JOIN LATERAL (VALUES (ef.zipl), (ef.zipr)) AS z(zip)
WHERE z.zip IS NOT NULL;

-- @SECTION:unload_state@
DELETE FROM @TIGER@.edges            WHERE statefp = '@STATEFP@';
DELETE FROM @TIGER@.faces            WHERE statefp = '@STATEFP@';
DELETE FROM @TIGER@.featnames        WHERE statefp = '@STATEFP@';
DELETE FROM @TIGER@.addr             WHERE statefp = '@STATEFP@';
DELETE FROM @TIGER@.place            WHERE statefp = '@STATEFP@';
DELETE FROM @TIGER@.cousub           WHERE statefp = '@STATEFP@';
DELETE FROM @TIGER@.zip_state        WHERE statefp = '@STATEFP@';
DELETE FROM @TIGER@.zip_state_loc    WHERE statefp = '@STATEFP@';
DELETE FROM @TIGER@.zip_lookup_base  WHERE statefp = '@STATEFP@';
DELETE FROM @TIGER@.edge_containment WHERE statefp = '@STATEFP@';
-- Per-state-clipped ZCTA rows; nation-level rows (statefp=NULL) survive.
DELETE FROM @TIGER@.zcta5            WHERE statefp = '@STATEFP@';
