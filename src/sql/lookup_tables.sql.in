-- Static lookup dictionaries seeded at extension load time.
-- Ported from postgis_tiger_geocoder src/tables/lookup_tables_2011.sql.
-- @TIGER@ is replaced at embed time with the fully-qualified schema name (default: main.tiger).

CREATE SCHEMA IF NOT EXISTS @TIGER@;

