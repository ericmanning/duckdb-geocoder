-- reverse_geocode(pt, max_results) → TABLE (per D6, one row per candidate
-- with `rank`).
--
-- Structural port of PG's src/geocode/reverse_geocode.sql. The PG body is a
-- plpgsql LOOP that mutates a `var_addy` record across iterations; we
-- vectorize it into a CTE chain that preserves the load-bearing predicates
-- and ordering.
--
-- Logic mapping (PG line numbers in scripts/parity/pg_compare/.../reverse_geocode.sql):
--   - L49–93   coverage: state → county → place|cousub → ZIP        → coverage CTEs.
--   - L107–123 face-side narrowing: faces ⨝ edges, eside = side
--               of edge facing the point                            → face_hits, candidates.
--   - L120–122 LEFT JOIN addr ON e.tlid=a.tlid AND e.eside=a.side    → side-aware join.
--   - L124–135 DISTINCT ON (tlid, side) tie-broken by `fullname ASC
--               NULLS LAST`                                         → QUALIFY ROW_NUMBER.
--   - L141–143 outer order: `dist<70 ? 0 : dist`, `fullname-present`,
--               `fromhn-present`, `dist`                            → ranked.
--   - L153–155 first iteration captures `var_primary_line`, `var_primary_dist` → primary.
--   - L158–164 first non-blank fullname becomes sticky street name   → sticky_primary.
--   - L166     filter: candidate must `ST_Intersects(line, primary_line)` → accepted.
--   - L171–179 interpolated address with parity correction (±1 if interpolated
--               parity ≠ tohn parity, prefer +1, fall back to -1)     → interp.
--   - L197     accept band: `dist < primary_dist*1.1 OR dist < 20`     → accepted.
--   - L208–223 back-patch rule: blank prior streetname overwritten by
--               next non-blank one. We forward-fill instead via
--               COALESCE(own, sticky_primary) — equivalent for the
--               array-of-snapshots PG produces.
--
-- Spec carve-outs (`reverse_geocode_numbered_roads` highway preference and
-- the cross-street array) are deferred — geocode_flow.md §10. Distance is
-- computed via UTM ST_Transform meters rather than ST_DistanceSphere; the
-- two agree to <1 m at TIGER scales.
--
-- Depends on spatial. Registered best-effort.

CREATE OR REPLACE MACRO @TIGER@.reverse_geocode(pt, max_results) AS TABLE (
    WITH
    -- PG L40-42: snap input pt to a 0.00005° grid (~5m) to "get rid of
    -- floating point junk that would prevent intersections." This shift
    -- is load-bearing — it changes ST_LineLocatePoint frac and can flip
    -- parity in the interpolated house number, which is what PG's parity
    -- correction then nudges. Skipping the snap makes us systematically
    -- off-by-a-few-houses on long edges (verified on PG TIGER 2025: T3, T4,
    -- T5, #2927, #3806 all flip when the snap is added).
    pt_info AS (
        SELECT @TIGER@.st_snaptogrid(pt, 0.00005) AS p,
               'EPSG:' || CAST(@TIGER@.utmzone(pt) AS VARCHAR) AS utm_crs,
               COALESCE(ST_CRS(pt), 'EPSG:4269') AS src_crs
    ),
    state_hit AS (
        SELECT s.statefp, s.stusps
        FROM @TIGER@.state s, pt_info
        WHERE ST_Intersects(s.the_geom, pt_info.p)
        LIMIT 1
    ),
    county_hit AS (
        SELECT c.statefp, c.countyfp, c.name AS county_name
        FROM @TIGER@.county c, pt_info, state_hit
        WHERE ST_Intersects(c.the_geom, pt_info.p)
          AND c.statefp = state_hit.statefp
        LIMIT 1
    ),
    -- tiger.zcta5 has both nation-level rows (statefp=NULL, from
    -- load_tiger_nation) and per-state-clipped rows (statefp=$STATEFP,
    -- from derived_zcta5_clip — one per (state, ZCTA) overlap with
    -- non-zero area; legitimate cross-state ZCTAs produce rows in each
    -- state they cover). Either flavour resolves the same ZIP via the
    -- spatial test, so we don't filter by statefp; this also lets us
    -- still resolve ZIPs in states that haven't been loaded.
    zip_hit AS (
        SELECT z.zcta5ce AS zip
        FROM @TIGER@.zcta5 z, pt_info
        WHERE ST_Intersects(z.the_geom, pt_info.p)
        LIMIT 1
    ),
    -- PG: place first; cousub fallback if no place hit (L72-85).
    place_hit AS (
        SELECT name AS place_name
        FROM (
            SELECT p.name, 0 AS pri
            FROM @TIGER@.place p, pt_info, state_hit
            WHERE ST_Intersects(p.the_geom, pt_info.p)
              AND p.statefp = state_hit.statefp
            UNION ALL
            SELECT cs.name, 1 AS pri
            FROM @TIGER@.cousub cs, pt_info, state_hit
            WHERE ST_Intersects(cs.the_geom, pt_info.p)
              AND cs.statefp = state_hit.statefp
        ) ranked_loc
        ORDER BY pri
        LIMIT 1
    ),
    -- Faces in the matching county that contain the point. Used to
    -- narrow edges and assign side-of-street (PG L107-114).
    face_hits AS (
        SELECT f.statefp, f.countyfp, f.tfid
        FROM @TIGER@.faces f, pt_info, state_hit, county_hit
        WHERE f.statefp = state_hit.statefp
          AND f.countyfp = county_hit.countyfp
          AND ST_Intersects(f.the_geom, pt_info.p)
    ),
    -- Edges adjacent to those faces. eside = side of edge facing the point.
    candidates AS (
        SELECT e.statefp, e.countyfp, e.tlid, e.fullname, e.the_geom AS edge_geom,
               e.zipl, e.zipr,
               CASE WHEN e.tfidr = f.tfid THEN 'R'
                    WHEN e.tfidl = f.tfid THEN 'L'
                    ELSE NULL END AS eside,
               -- Linestring form for ST_LineLocatePoint / ST_ClosestPoint.
               CASE CAST(ST_GeometryType(e.the_geom) AS VARCHAR)
                   WHEN 'LINESTRING' THEN e.the_geom
                   WHEN 'MULTILINESTRING' THEN ST_LineMerge(e.the_geom)
               END AS line,
               ST_Distance(
                   ST_Transform(e.the_geom, pt_info.src_crs, pt_info.utm_crs, always_xy := true),
                   ST_Transform(pt_info.p, pt_info.src_crs, pt_info.utm_crs, always_xy := true)
               ) AS dist_m
        FROM @TIGER@.edges e
        JOIN face_hits f ON f.statefp = e.statefp
                         AND f.countyfp = e.countyfp
                         AND (e.tfidr = f.tfid OR e.tfidl = f.tfid)
        CROSS JOIN pt_info
        WHERE e.mtfcc LIKE 'S%'
          AND ST_DWithin(e.the_geom, pt_info.p, 0.01)
    ),
    -- Per (tlid, side): pick one featname-flavor (PG's DISTINCT ON
    -- tlid,side, tiebreak fullname ASC NULLS LAST) and side-aware addr row.
    candidates_with_features AS (
        SELECT c.*,
               n.fullname     AS fn_fullname,
               n.name         AS fn_streetname,
               n.predirabrv   AS fn_pre_dir,
               n.sufdirabrv   AS fn_post_dir,
               COALESCE(n.suftypabrv, n.pretypabrv) AS fn_street_type,
               a.fromhn, a.tohn, a.zip AS addr_zip
        FROM candidates c
        LEFT JOIN @TIGER@.featnames n
               ON n.statefp = c.statefp AND n.tlid = c.tlid
        LEFT JOIN @TIGER@.addr a
               ON a.statefp = c.statefp AND a.tlid = c.tlid AND a.side = c.eside
        QUALIFY ROW_NUMBER() OVER (
            PARTITION BY c.tlid, c.eside
            ORDER BY (CASE WHEN n.fullname IS NULL OR n.fullname = '' THEN 1 ELSE 0 END),
                     n.fullname
        ) = 1
    ),
    -- Top 50 ranked by PG's outer key (L141-143).
    ranked AS (
        SELECT *,
               ROW_NUMBER() OVER (
                   ORDER BY (CASE WHEN dist_m < 70 THEN 0 ELSE dist_m END),
                            (CASE WHEN fn_fullname IS NULL OR fn_fullname = '' THEN 1 ELSE 0 END),
                            (CASE WHEN fromhn IS NULL THEN 1 ELSE 0 END),
                            dist_m
               ) AS pg_rank
        FROM candidates_with_features
        QUALIFY pg_rank <= 50
    ),
    -- PG's "primary": the first candidate (rank=1) sets primary_line + dist.
    primary_row AS (
        SELECT line AS primary_line, dist_m AS primary_dist
        FROM ranked WHERE pg_rank = 1
    ),
    -- PG's "first non-blank fullname becomes sticky" — the lowest-ranked
    -- candidate that has a non-blank streetname. Used to forward-fill rows
    -- whose own featnames row is blank (PG's back-patch L208-223).
    sticky_primary AS (
        SELECT fn_streetname AS s_name, fn_street_type AS s_type,
               fn_pre_dir AS s_pre, fn_post_dir AS s_post
        FROM ranked
        WHERE fn_fullname IS NOT NULL AND fn_fullname <> ''
        ORDER BY pg_rank
        LIMIT 1
    ),
    -- PG L166 + L197: candidate intersects primary_line AND
    -- (dist<primary_dist*1.1 OR dist<20).
    accepted AS (
        SELECT r.*,
               ROW_NUMBER() OVER (ORDER BY r.pg_rank) AS new_rank
        FROM ranked r, primary_row p
        WHERE ST_Intersects(r.line, p.primary_line)
          AND (r.dist_m < p.primary_dist * 1.1 OR r.dist_m < 20)
    ),
    -- Interpolate house number along the edge (PG L173).
    -- raw_hn = fromhn + frac * (tohn - fromhn), preserving direction so
    -- descending ranges (fromhn > tohn) interpolate downward.
    interp AS (
        SELECT a.*,
               TRY_CAST(a.fromhn AS INTEGER) AS fhn,
               TRY_CAST(a.tohn   AS INTEGER) AS thn,
               ST_LineLocatePoint(a.line, (SELECT p FROM pt_info)) AS frac
        FROM accepted a
    ),
    interp_raw AS (
        SELECT i.*,
               CAST(i.fhn + i.frac * (i.thn - i.fhn) AS INTEGER) AS raw_hn
        FROM interp i
    ),
    -- PG's parity correction L175-177: if interpolated parity ≠ tohn parity,
    -- prefer +1 if it stays within [fromhn, tohn], else -1. We use
    -- LEAST/GREATEST in the bounds check so descending ranges (fromhn>tohn)
    -- still consider in-range candidates — PG's literal BETWEEN fromhn AND
    -- tohn returns false for descending ranges and silently picks raw-1, a
    -- minor bug we don't replicate.
    hn_resolved AS (
        SELECT i.*,
               CASE
                   WHEN i.fhn IS NULL OR i.thn IS NULL THEN NULL
                   WHEN (i.raw_hn % 2) = (i.thn % 2) THEN i.raw_hn
                   WHEN (i.raw_hn + 1) BETWEEN LEAST(i.fhn, i.thn) AND GREATEST(i.fhn, i.thn)
                        THEN i.raw_hn + 1
                   ELSE i.raw_hn - 1
               END AS hn
        FROM interp_raw i
    )
    SELECT
        new_rank AS rank,
        STRUCT_PACK(
            address      := hn,
            -- PG L208-223 back-patches blank streetnames with the next
            -- non-blank one; we forward-fill by COALESCEing own → sticky.
            street_name  := COALESCE(NULLIF(fn_streetname, ''),
                                     (SELECT s_name FROM sticky_primary)),
            street_type  := COALESCE(NULLIF(fn_street_type, ''),
                                     (SELECT s_type FROM sticky_primary)),
            internal     := NULL::VARCHAR,
            pre_dir      := COALESCE(NULLIF(fn_pre_dir, ''),
                                     (SELECT s_pre FROM sticky_primary)),
            post_dir     := COALESCE(NULLIF(fn_post_dir, ''),
                                     (SELECT s_post FROM sticky_primary)),
            location     := (SELECT place_name FROM place_hit),
            state_abbrev := (SELECT stusps FROM state_hit),
            -- PG L180-184: prefer addr.zip, fall back to point's ZCTA.
            -- Treat empty-string zip as missing too (PG's `var_redge.zip > ''`).
            zip          := COALESCE(NULLIF(addr_zip, ''), (SELECT zip FROM zip_hit))
        )::@TIGER@.geocode_input AS adr,
        ST_ClosestPoint(line, (SELECT p FROM pt_info)) AS geom,
        fn_fullname AS street,
        dist_m
    FROM hn_resolved
    WHERE new_rank <= max_results
    ORDER BY new_rank
);
